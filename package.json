{
  "name": "rayaan-hotel-saas",
  "private": true,
  "version": "0.1.0",
  "description": "Offline-first multi-tenant hotel and restaurant management SaaS.",
  "scripts": {
    "dev": "pnpm dev:services && pnpm -r --parallel dev",
    "dev:services": "docker compose -f infra/docker-compose.dev.yml up -d",
    "dev:web": "pnpm --filter @rayaan/web dev",
    "dev:api": "pnpm --filter @rayaan/api dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @rayaan/database db:generate",
    "db:migrate": "pnpm --filter @rayaan/database db:migrate"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@9.12.3"
}
