generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                    String            @id @default(cuid())
  name                  String
  slug                  String            @unique
  clerkOrgId            String            @unique
  operatingModel        String            @default("hotel_restaurant")
  mobileMoneyProvider   String?
  onboardingCompletedAt DateTime?
  status                String            @default("active")
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  properties            Property[]
  users                 TenantUser[]
  stays                 Stay[]
  guestFolios           GuestFolio[]
  hotelAuditLogs        HotelAuditLog[]
  staffInvitations      StaffInvitation[]
}

model TenantUser {
  id                   String    @id @default(cuid())
  tenantId             String
  clerkUserId          String
  role                 String
  status               String    @default("active")
  removedAt            DateTime?
  removedByClerkUserId String?
  createdAt            DateTime  @default(now())
  tenant               Tenant    @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, clerkUserId])
  @@index([clerkUserId])
  @@index([tenantId, status])
}

model StaffInvitation {
  id                    String   @id @default(cuid())
  tenantId              String
  clerkOrgId            String
  clerkInvitationId     String?  @unique
  invitationUrl         String?
  email                 String
  role                  String
  status                String   @default("pending")
  invitedByClerkUserId  String
  acceptedByClerkUserId String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  tenant                Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, email])
  @@index([clerkOrgId, email])
}

model Property {
  id                String             @id @default(cuid())
  tenantId          String
  name              String
  city              String?
  roomCount         Int?
  timezone          String             @default("Africa/Mogadishu")
  currency          String             @default("USD")
  taxRate           Decimal?
  serviceChargeRate Decimal?
  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  rooms             Room[]
  roomTypes         RoomType[]
  ratePlans         RatePlan[]
  stays             Stay[]
  guestFolios       GuestFolio[]
  hotelAuditLogs    HotelAuditLog[]
  hotelReservations HotelReservation[]
  restaurants       Restaurant[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([tenantId])
}

model Restaurant {
  id                String            @id @default(cuid())
  tenantId          String
  propertyId        String
  name              String
  serviceStyle      String?
  taxRate           Decimal?
  serviceChargeRate Decimal?
  property          Property          @relation(fields: [propertyId], references: [id])
  menuCategories    MenuCategory[]
  menuItems         MenuItem[]
  kitchenStations   KitchenStation[]
  tables            RestaurantTable[]
  orders            Order[]
  reservations      Reservation[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([tenantId, propertyId])
}

model KitchenStation {
  id           String             @id @default(cuid())
  tenantId     String
  propertyId   String
  restaurantId String
  name         String
  type         KitchenStationType
  displayOrder Int                @default(0)
  isActive     Boolean            @default(true)
  restaurant   Restaurant         @relation(fields: [restaurantId], references: [id])
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@unique([restaurantId, type])
  @@index([tenantId, propertyId, restaurantId, isActive])
}

model Room {
  id                String             @id @default(cuid())
  tenantId          String
  propertyId        String
  roomTypeId        String?
  number            String
  type              String
  status            RoomStatus         @default(available)
  property          Property           @relation(fields: [propertyId], references: [id])
  roomType          RoomType?          @relation(fields: [roomTypeId], references: [id])
  stays             Stay[]
  hotelAuditLogs    HotelAuditLog[]
  hotelReservations HotelReservation[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@unique([propertyId, number])
  @@index([tenantId, propertyId, status])
  @@index([tenantId, propertyId, roomTypeId])
}

enum RoomStatus {
  available
  occupied
  cleaning
  maintenance
  out_of_order
}

model RoomType {
  id                String             @id @default(cuid())
  tenantId          String
  propertyId        String
  name              String
  code              String
  description       String?
  baseOccupancy     Int                @default(1)
  maxOccupancy      Int?
  defaultCurrency   String             @default("USD")
  defaultRate       Decimal?
  isActive          Boolean            @default(true)
  property          Property           @relation(fields: [propertyId], references: [id])
  rooms             Room[]
  ratePlans         RatePlan[]
  roomRates         RoomRate[]
  hotelReservations HotelReservation[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@unique([propertyId, code])
  @@index([tenantId, propertyId, isActive])
}

model RatePlan {
  id                 String              @id @default(cuid())
  tenantId           String
  propertyId         String
  roomTypeId         String?
  name               String
  code               String
  description        String?
  status             RatePlanStatus      @default(active)
  currency           String              @default("USD")
  defaultRate        Decimal?
  baseOccupancy      Int                 @default(1)
  extraGuestRate     Decimal             @default(0)
  minNights          Int                 @default(1)
  property           Property            @relation(fields: [propertyId], references: [id])
  roomType           RoomType?           @relation(fields: [roomTypeId], references: [id])
  roomRates          RoomRate[]
  cancellationPolicy CancellationPolicy?
  hotelReservations  HotelReservation[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([propertyId, code])
  @@index([tenantId, propertyId, status])
  @@index([tenantId, propertyId, roomTypeId])
}

model RoomRate {
  id             String   @id @default(cuid())
  tenantId       String
  propertyId     String
  ratePlanId     String
  roomTypeId     String
  startDate      DateTime
  endDate        DateTime
  baseRate       Decimal
  extraGuestRate Decimal  @default(0)
  baseOccupancy  Int      @default(1)
  minNights      Int      @default(1)
  currency       String
  isActive       Boolean  @default(true)
  ratePlan       RatePlan @relation(fields: [ratePlanId], references: [id])
  roomType       RoomType @relation(fields: [roomTypeId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([tenantId, propertyId, roomTypeId, startDate, endDate])
  @@index([tenantId, propertyId, ratePlanId, isActive])
}

model CancellationPolicy {
  id                         String                  @id @default(cuid())
  tenantId                   String
  propertyId                 String
  ratePlanId                 String                  @unique
  freeCancellationUntilHours Int?
  penaltyType                CancellationPenaltyType @default(none)
  penaltyValue               Decimal                 @default(0)
  noShowPenaltyType          CancellationPenaltyType @default(none)
  noShowPenaltyValue         Decimal                 @default(0)
  ratePlan                   RatePlan                @relation(fields: [ratePlanId], references: [id])
  createdAt                  DateTime                @default(now())
  updatedAt                  DateTime                @updatedAt

  @@index([tenantId, propertyId])
}

enum RatePlanStatus {
  active
  inactive
}

enum CancellationPenaltyType {
  none
  fixed
  percent
  first_night
}

model Guest {
  id                     String                  @id @default(cuid())
  tenantId               String
  firstName              String
  lastName               String
  email                  String?
  phone                  String?
  stays                  Stay[]
  guestFolios            GuestFolio[]
  hotelReservationGuests HotelReservationGuest[]
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  @@index([tenantId, phone])
  @@index([tenantId, email])
}

model HotelReservation {
  id                    String                  @id @default(cuid())
  tenantId              String
  propertyId            String
  roomTypeId            String
  assignedRoomId        String?
  ratePlanId            String?
  confirmationCode      String
  status                HotelReservationStatus  @default(confirmed)
  source                HotelReservationSource  @default(walk_in)
  arrivalDate           DateTime
  departureDate         DateTime
  adultCount            Int                     @default(1)
  childCount            Int                     @default(0)
  guestName             String
  guestEmail            String?
  guestPhone            String?
  depositRequiredAmount Decimal                 @default(0)
  depositPaidAmount     Decimal                 @default(0)
  currency              String
  rateOverride          Decimal?
  notes                 String?
  specialRequests       String?
  createdByUserId       String
  statusChangedByUserId String?
  statusChangedAt       DateTime?
  property              Property                @relation(fields: [propertyId], references: [id])
  roomType              RoomType                @relation(fields: [roomTypeId], references: [id])
  assignedRoom          Room?                   @relation(fields: [assignedRoomId], references: [id])
  ratePlan              RatePlan?               @relation(fields: [ratePlanId], references: [id])
  guests                HotelReservationGuest[]
  guarantee             ReservationGuarantee?
  stay                  Stay?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  @@unique([tenantId, confirmationCode])
  @@index([tenantId, propertyId, arrivalDate, departureDate])
  @@index([tenantId, propertyId, status])
  @@index([tenantId, roomTypeId, arrivalDate])
  @@index([tenantId, assignedRoomId, arrivalDate])
}

model HotelReservationGuest {
  id            String           @id @default(cuid())
  tenantId      String
  propertyId    String
  reservationId String
  guestId       String?
  firstName     String
  lastName      String
  email         String?
  phone         String?
  isPrimary     Boolean          @default(false)
  reservation   HotelReservation @relation(fields: [reservationId], references: [id])
  guest         Guest?           @relation(fields: [guestId], references: [id])
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([tenantId, propertyId, reservationId])
  @@index([tenantId, guestId])
}

model ReservationGuarantee {
  id            String                     @id @default(cuid())
  tenantId      String
  propertyId    String
  reservationId String                     @unique
  method        String
  provider      String?
  providerToken String?
  status        ReservationGuaranteeStatus @default(active)
  reservation   HotelReservation           @relation(fields: [reservationId], references: [id])
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt

  @@index([tenantId, propertyId, status])
}

enum HotelReservationStatus {
  draft
  confirmed
  guaranteed
  checked_in
  checked_out
  cancelled
  no_show
}

enum HotelReservationSource {
  walk_in
  phone
  direct
  ota
  corporate
}

enum ReservationGuaranteeStatus {
  active
  released
  charged
  failed
}

model Stay {
  id                 String            @id @default(cuid())
  tenantId           String
  propertyId         String
  roomId             String
  guestId            String
  hotelReservationId String?           @unique
  status             StayStatus        @default(active)
  checkInAt          DateTime          @default(now())
  expectedCheckOutAt DateTime?
  checkOutAt         DateTime?
  checkedInByUserId  String
  checkedOutByUserId String?
  notes              String?
  tenant             Tenant            @relation(fields: [tenantId], references: [id])
  property           Property          @relation(fields: [propertyId], references: [id])
  room               Room              @relation(fields: [roomId], references: [id])
  guest              Guest             @relation(fields: [guestId], references: [id])
  hotelReservation   HotelReservation? @relation(fields: [hotelReservationId], references: [id])
  guestFolio         GuestFolio?
  folioCharges       FolioCharge[]
  hotelAuditLogs     HotelAuditLog[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([tenantId, status])
  @@index([tenantId, roomId, status])
  @@index([tenantId, guestId, checkInAt])
  @@index([tenantId, hotelReservationId])
}

enum StayStatus {
  active
  checked_out
}

model HotelAuditLog {
  id            String          @id @default(cuid())
  tenantId      String
  propertyId    String
  roomId        String?
  stayId        String?
  reservationId String?
  event         HotelAuditEvent
  actorId       String?
  actorRole     String?
  previousState Json?
  newState      Json?
  createdAt     DateTime        @default(now())
  tenant        Tenant          @relation(fields: [tenantId], references: [id])
  property      Property        @relation(fields: [propertyId], references: [id])
  room          Room?           @relation(fields: [roomId], references: [id])
  stay          Stay?           @relation(fields: [stayId], references: [id])

  @@index([tenantId, propertyId, createdAt])
  @@index([tenantId, roomId, createdAt])
  @@index([tenantId, stayId, createdAt])
  @@index([tenantId, reservationId, createdAt])
}

enum HotelAuditEvent {
  room_status_changed
  check_in_completed
  check_out_completed
}

enum FolioStatus {
  open
  pending_checkout
  closed
  locked
  void
}

enum FolioLineItemType {
  room_night
  restaurant_charge
  manual_charge
  tax
  service_charge
  discount
  deposit
  refund
  adjustment
}

enum FolioPaymentStatus {
  pending
  confirmed
  failed
  refunded
  voided
}

enum FolioAdjustmentStatus {
  pending
  approved
  rejected
  posted
  voided
}

model GuestFolio {
  id              String            @id @default(cuid())
  tenantId        String
  propertyId      String
  stayId          String            @unique
  guestId         String
  status          FolioStatus       @default(open)
  currency        String
  balance         Decimal           @default(0)
  openedAt        DateTime          @default(now())
  closedAt        DateTime?
  lockedAt        DateTime?
  createdByUserId String?
  closedByUserId  String?
  tenant          Tenant            @relation(fields: [tenantId], references: [id])
  property        Property          @relation(fields: [propertyId], references: [id])
  stay            Stay              @relation(fields: [stayId], references: [id])
  guest           Guest             @relation(fields: [guestId], references: [id])
  lineItems       FolioLineItem[]
  payments        FolioPayment[]
  adjustments     FolioAdjustment[]
  legacyCharges   FolioCharge[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([tenantId, propertyId, status])
  @@index([tenantId, guestId, openedAt])
}

model FolioLineItem {
  id          String            @id @default(cuid())
  tenantId    String
  propertyId  String
  folioId     String
  type        FolioLineItemType
  description String
  quantity    Decimal           @default(1)
  unitAmount  Decimal?
  amount      Decimal
  currency    String
  sourceType  String?
  sourceId    String?
  postedById  String?
  voidedAt    DateTime?
  voidedById  String?
  voidReason  String?
  folio       GuestFolio        @relation(fields: [folioId], references: [id])
  adjustments FolioAdjustment[]
  createdAt   DateTime          @default(now())

  @@index([tenantId, propertyId, folioId, createdAt])
  @@index([tenantId, sourceType, sourceId])
}

model FolioPayment {
  id                    String             @id @default(cuid())
  tenantId              String
  propertyId            String
  folioId               String
  method                String
  provider              String?
  providerTransactionId String?
  reference             String?
  status                FolioPaymentStatus @default(pending)
  amount                Decimal
  currency              String
  paidAt                DateTime?
  recordedById          String?
  refundedAt            DateTime?
  refundedById          String?
  refundReason          String?
  metadata              Json?
  folio                 GuestFolio         @relation(fields: [folioId], references: [id])
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@unique([tenantId, method, reference])
  @@index([tenantId, propertyId, folioId, status])
}

model FolioAdjustment {
  id             String                @id @default(cuid())
  tenantId       String
  propertyId     String
  folioId        String
  lineItemId     String?
  amount         Decimal
  currency       String
  reason         String
  status         FolioAdjustmentStatus @default(posted)
  authorizedById String?
  createdById    String
  folio          GuestFolio            @relation(fields: [folioId], references: [id])
  lineItem       FolioLineItem?        @relation(fields: [lineItemId], references: [id])
  createdAt      DateTime              @default(now())

  @@index([tenantId, propertyId, folioId, createdAt])
  @@index([tenantId, lineItemId])
}

model FolioCharge {
  id           String   @id @default(cuid())
  tenantId     String
  propertyId   String
  stayId       String
  folioId      String?
  orderId      String?
  restaurantId String?
  amount       Decimal
  currency     String
  description  String
  postedById   String
  createdAt    DateTime @default(now())

  stay  Stay        @relation(fields: [stayId], references: [id])
  folio GuestFolio? @relation(fields: [folioId], references: [id])

  @@index([tenantId, stayId, createdAt])
  @@index([tenantId, folioId])
  @@index([tenantId, orderId])
}

model RestaurantTable {
  id                   String     @id @default(cuid())
  tenantId             String
  propertyId           String
  restaurantId         String
  name                 String
  status               String     @default("free")
  coverCount           Int        @default(0)
  assignedWaiterUserId String?
  assignedWaiterName   String?
  qrCode               String?
  restaurant           Restaurant @relation(fields: [restaurantId], references: [id])
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  @@index([tenantId, propertyId, restaurantId])
  @@index([tenantId, restaurantId, status])
}

model Reservation {
  id           String            @id @default(cuid())
  tenantId     String
  propertyId   String
  restaurantId String
  guestName    String
  guestId      String?
  partySize    Int
  scheduledAt  DateTime
  tableId      String?
  status       ReservationStatus @default(confirmed)
  notes        String?
  restaurant   Restaurant        @relation(fields: [restaurantId], references: [id])
  items        ReservationItem[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([tenantId, propertyId, restaurantId, scheduledAt])
  @@index([tenantId, restaurantId, status])
  @@index([tenantId, tableId, scheduledAt])
}

model ReservationItem {
  id            String      @id @default(cuid())
  tenantId      String
  propertyId    String
  reservationId String
  menuItemId    String?
  name          String
  quantity      Int         @default(1)
  unitPrice     Decimal
  totalPrice    Decimal
  notes         String?
  reservation   Reservation @relation(fields: [reservationId], references: [id])
  menuItem      MenuItem?   @relation(fields: [menuItemId], references: [id])
  createdAt     DateTime    @default(now())

  @@index([tenantId, reservationId])
  @@index([menuItemId])
}

enum ReservationStatus {
  confirmed
  waitlisted
  seated
  cancelled
  no_show
}

model Order {
  id                  String             @id @default(cuid())
  tenantId            String
  propertyId          String
  restaurantId        String
  tableId             String?
  source              OrderSource        @default(dine_in)
  covers              Int                @default(0)
  waiterId            String?
  status              String             @default("draft")
  subtotal            Decimal            @default(0)
  taxAmount           Decimal            @default(0)
  taxRate             Decimal            @default(0)
  serviceChargeAmount Decimal            @default(0)
  serviceChargeRate   Decimal            @default(0)
  discountAmount      Decimal            @default(0)
  totalAmount         Decimal            @default(0)
  paymentStatus       OrderPaymentStatus @default(unpaid)
  currency            String             @default("USD")
  closedAt            DateTime?
  closedById          String?
  notes               String?
  courseCount         Int                @default(1)
  idempotencyKey      String?
  restaurant          Restaurant         @relation(fields: [restaurantId], references: [id])
  items               OrderItem[]
  payments            OrderPayment[]
  discounts           OrderDiscount[]
  auditLogs           OrderAuditLog[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, propertyId, restaurantId, status])
}

enum OrderSource {
  dine_in
  counter
  takeaway
  delivery
  room_service
}

enum OrderPaymentStatus {
  unpaid
  partial
  paid
  refunded
  voided
}

model MenuCategory {
  id             String              @id @default(cuid())
  tenantId       String
  propertyId     String
  restaurantId   String
  name           String
  defaultStation KitchenStationType?
  sortOrder      Int                 @default(0)
  isActive       Boolean             @default(true)
  restaurant     Restaurant          @relation(fields: [restaurantId], references: [id])
  items          MenuItem[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([tenantId, propertyId, restaurantId, isActive])
}

model MenuItem {
  id               String              @id @default(cuid())
  tenantId         String
  propertyId       String
  restaurantId     String
  categoryId       String?
  name             String
  description      String?
  imageUrl         String?
  kitchenStation   KitchenStationType?
  allergens        String[]            @default([])
  dietary          String[]            @default([])
  stockEnabled     Boolean             @default(false)
  currentStock     Int?
  isAvailable      Boolean             @default(true)
  price            Decimal
  currency         String              @default("USD")
  isActive         Boolean             @default(true)
  restaurant       Restaurant          @relation(fields: [restaurantId], references: [id])
  category         MenuCategory?       @relation(fields: [categoryId], references: [id])
  orderItems       OrderItem[]
  reservationItems ReservationItem[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([tenantId, propertyId, restaurantId, isActive])
  @@index([tenantId, restaurantId, isAvailable])
  @@index([categoryId])
}

model OrderItem {
  id             String              @id @default(cuid())
  tenantId       String
  propertyId     String
  orderId        String
  menuItemId     String?
  name           String
  quantity       Int                 @default(1)
  status         OrderItemStatus     @default(pending)
  voidedAt       DateTime?
  voidedById     String?
  voidReason     String?
  course         Int                 @default(1)
  kitchenStation KitchenStationType?
  modifiers      Json?
  unitPrice      Decimal
  totalPrice     Decimal
  sentAt         DateTime?
  preparedAt     DateTime?
  servedAt       DateTime?
  notes          String?
  order          Order               @relation(fields: [orderId], references: [id])
  menuItem       MenuItem?           @relation(fields: [menuItemId], references: [id])
  discounts      OrderDiscount[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([tenantId, propertyId, orderId])
  @@index([tenantId, orderId, status])
  @@index([menuItemId])
}

enum OrderItemStatus {
  pending
  sent
  preparing
  ready
  served
  voided
}

enum KitchenStationType {
  bar
  grill
  main_kitchen
  dessert
  cold_station
}

model Payment {
  id                    String   @id @default(cuid())
  tenantId              String
  propertyId            String
  restaurantId          String?
  orderId               String?
  folioId               String?
  provider              String
  providerTransactionId String?
  method                String
  status                String   @default("pending")
  amount                Decimal
  currency              String   @default("USD")
  accessCode            String?
  checkoutUrl           String?
  customerPhone         String?
  idempotencyKey        String   @unique
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([tenantId, propertyId, status])
  @@index([provider, providerTransactionId])
}

model PaymentWebhookLog {
  id              String                @id @default(cuid())
  provider        String
  reference       String?
  tenantId        String?
  propertyId      String?
  restaurantId    String?
  orderId         String?
  payload         Json
  verifiedAt      DateTime?
  outcome         PaymentWebhookOutcome
  rejectionReason String?
  createdAt       DateTime              @default(now())

  @@index([provider, reference])
  @@index([tenantId, createdAt])
}

model IdempotencyRecord {
  id             String   @id @default(cuid())
  tenantId       String
  actorId        String
  key            String
  route          String
  requestHash    String
  responseStatus Int      @default(200)
  responseBody   Json
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([tenantId, key])
  @@index([tenantId, expiresAt])
  @@index([tenantId, actorId, route])
}

enum PaymentWebhookOutcome {
  success
  rejected
  duplicate
}

model OrderPayment {
  id           String                   @id @default(cuid())
  tenantId     String
  propertyId   String
  restaurantId String
  orderId      String
  method       OrderPaymentMethod
  amount       Decimal
  currency     String
  reference    String?
  status       OrderPaymentLedgerStatus @default(pending)
  paidAt       DateTime?
  recordedById String?
  refundedAt   DateTime?
  refundedById String?
  refundReason String?
  metadata     Json?
  createdAt    DateTime                 @default(now())

  order Order @relation(fields: [orderId], references: [id])

  @@unique([tenantId, method, reference])
  @@index([tenantId, orderId, status])
}

enum OrderPaymentMethod {
  paystack
  cash
  card_manual
  room_charge
  complimentary
  voucher
}

enum OrderPaymentLedgerStatus {
  pending
  confirmed
  failed
  refunded
}

model OrderDiscount {
  id           String            @id @default(cuid())
  tenantId     String
  propertyId   String
  restaurantId String
  orderId      String
  orderItemId  String?
  type         OrderDiscountType
  label        String
  amount       Decimal
  appliedById  String
  approvedById String?
  createdAt    DateTime          @default(now())

  order     Order      @relation(fields: [orderId], references: [id])
  orderItem OrderItem? @relation(fields: [orderItemId], references: [id])

  @@index([tenantId, orderId])
  @@index([tenantId, orderItemId])
}

enum OrderDiscountType {
  percent
  fixed
  item
}

model OrderAuditLog {
  id            String          @id @default(cuid())
  tenantId      String
  propertyId    String
  restaurantId  String
  orderId       String
  event         OrderAuditEvent
  actorId       String?
  actorRole     String?
  previousState Json?
  newState      Json?
  createdAt     DateTime        @default(now())

  order Order @relation(fields: [orderId], references: [id])

  @@index([tenantId, orderId, createdAt])
}

enum OrderAuditEvent {
  order_created
  item_added
  item_removed
  item_voided
  status_changed
  payment_initiated
  payment_confirmed
  payment_refunded
  discount_applied
  order_closed
  order_cancelled
  charge_to_room_posted
  table_transferred
  course_fired
}

model OfflineAction {
  id             String    @id
  tenantId       String
  propertyId     String
  restaurantId   String?
  deviceId       String
  actorUserId    String
  entityType     String
  entityId       String?
  actionType     String
  payload        Json
  idempotencyKey String    @unique
  status         String    @default("queued")
  conflictReason String?
  lastError      String?
  retryCount     Int       @default(0)
  occurredAt     DateTime
  resolvedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([tenantId, propertyId, status])
  @@index([deviceId, occurredAt])
}
